    // Setup size options with defaults
    function setupSizeOptions(select, option) {
        option.options.forEach(optValue => {
            const optElement = document.createElement('option');
            optElement.value = optValue.id;
            optElement.setAttribute('data-price', optValue.price_modifier || 0);
            optElement.textContent = `Size ${optValue.name}`;
            
            // Set default selection
            if (optValue.id === option.default || (!option.default && optValue === option.options[0])) {
                optElement.selected = true;
            }
            
            select.appendChild(optElement);
        });
    }

    // Add inner engraving option
    function addEngravingOption(container) {
        const engravingGroup = document.createElement('div');
        engravingGroup.className = 'option-group';
        engravingGroup.id = 'engraving-group';
        
        const label = document.createElement('label');
        label.setAttribute('for', 'inner-engraving');
        label.textContent = 'Inner Engraving (Optional):';
        engravingGroup.appendChild(label);
        
        const inputWrapper = document.createElement('div');
        inputWrapper.className = 'engraving-wrapper';
        
        const input = document.createElement('input');
        input.type = 'text';
        input.id = 'inner-engraving';
        input.maxLength = 10;
        input.placeholder = 'Max 10 characters';
        input.style.marginRight = '10px';
        
        const counter = document.createElement('span');
        counter.id = 'char-counter';
        counter.textContent = '0/10';
        counter.style.fontSize = '0.8em';
        counter.style.color = '#666';
        
        input.oninput = function() {
            const count = this.value.length;
            counter.textContent = `${count}/10`;
            counter.style.color = count > 8 ? '#ff6b6b' : '#666';
        };
        
        inputWrapper.appendChild(input);
        inputWrapper.appendChild(counter);
        engravingGroup.appendChild(inputWrapper);
        container.appendChild(engravingGroup);
    }

    // Update product ID based on width and size selection
    function updateProductId() {
        if (!window.currentProduct || !window.celticWidthMapping) return;
        
        const widthSelect = document.getElementById('width');
        const sizeSelect = document.getElementById('size');
        const productIdDisplay = document.getElementById('product-id');
        
        if (widthSelect && sizeSelect && productIdDisplay) {
            const selectedWidth = widthSelect.value;
            const selectedSize = parseFloat(sizeSelect.value);
            
            // Get base product ID for selected width
            const baseId = window.celticWidthMapping[selectedWidth];
            
            if (baseId) {
                // Apply L/M suffix based on size
                const suffix = selectedSize <= 8 ? 'L' : 'M';
                const finalProductId = baseId + suffix;
                
                productIdDisplay.textContent = finalProductId;
                
                // Update the modal title too
                const modalTitle = document.getElementById('catalog-modal-title');
                if (modalTitle) {
                    modalTitle.textContent = `${finalProductId} - Celtic Band`;
                }
            }
        }
    }

    // Update price based on selections
    function updatePrice() {
        let basePrice = 550; // Celtic base price
        let totalPrice = basePrice;
        
        // Find all configurator selects and sum their price modifiers
        const allSelects = document.querySelectorAll('.configurator-options select');
        allSelects.forEach(select => {
            if (select.selectedOptions.length > 0) {
                const priceModifier = parseInt(select.selectedOptions[0].dataset.price) || 0;
                totalPrice += priceModifier;
            }
        });
        
        // Check for two-tone pricing (Celtic specific)
        const patternSelect = document.getElementById('pattern_metal');
        const bandSelect = document.getElementById('band_metal');
        if (patternSelect && bandSelect && 
            patternSelect.style.display !== 'none' && bandSelect.style.display !== 'none') {
            if (patternSelect.value !== bandSelect.value) {
                totalPrice += 150; // Two-tone charge
            }
        }
        
        // Update display
        const priceDisplay = document.getElementById('total-price');
        if (priceDisplay) {
            priceDisplay.textContent = `$${totalPrice}`;
        }
    }

    // Setup specifications section
    function setupSpecifications(product) {
        const specContent = document.getElementById('spec-content');
        let specs = [];
        
        if (product.width_mm) specs.push(`Width: ${product.width_mm}mm`);
        if (product.profile) specs.push(`Profile: ${product.profile.replace('_', ' ')}`);
        if (product.series) specs.push(`Series: ${product.series}`);
        if (product.gender_variant && product.gender_variant !== 'unisex') {
            specs.push(`Gender: ${product.gender_variant === 'M' ? 'Mens' : 'Ladies'}`);
        }
        if (product.diamond_count && product.diamond_count > 0) {
            specs.push(`Diamonds: ${product.diamond_count}`);
        }
        if (product.white_gold_available) {
            specs.push('Available in White Gold');
        }
        
        specContent.innerHTML = specs.length > 0 ? 
            specs.map(spec => `<div class="spec-item">${spec}</div>`).join('') :
            '<div class="spec-item">No additional specifications available</div>';
    }

    // Request quote functionality
    function requestQuote() {
        if (currentProductData) {
            const productIdDisplay = document.getElementById('product-id');
            const currentDisplayedId = productIdDisplay ? productIdDisplay.textContent : currentProductData.product_id;
            
            const productInfo = {
                id: currentDisplayedId, // Use the dynamically updated product ID
                name: currentProductData.product_name || currentDisplayedId,
                category: currentProductData.category
            };
            
            // Add configurator selections if applicable
            if (currentProductData.category === 'celtic_bands') {
                productInfo.configuration = {};
                
                // Get all configurator selections
                const allSelects = document.querySelectorAll('.configurator-options select');
                allSelects.forEach(select => {
                    if (select.value) {
                        const optionKey = select.getAttribute('data-option-key');
                        productInfo.configuration[optionKey] = {
                            value: select.value,
                            label: select.selectedOptions[0].textContent
                        };
                    }
                });
                
                // Add engraving if specified
                const engravingInput = document.getElementById('inner-engraving');
                if (engravingInput && engravingInput.value.trim()) {
                    productInfo.configuration.inner_engraving = engravingInput.value.trim();
                }
                
                // Add calculated total price
                const priceDisplay = document.getElementById('total-price');
                if (priceDisplay) {
                    productInfo.estimated_price = priceDisplay.textContent;
                }
            }
            
            // Open contact modal with product context
            if (typeof openContactModalWithTracking === 'function') {
                openContactModalWithTracking('Catalog Modal', `Quote Request - ${productInfo.id}`, JSON.stringify(productInfo));
            } else {
                // Fallback - could implement a simple quote form
                alert(`Quote requested for ${productInfo.name} (${productInfo.id}). Please contact us for pricing.`);
            }
        }
    }

    // View PDF page functionality
    function viewPdfPage() {
        if (currentProductData && currentProductData.page_reference) {
            const pdfFile = `./Cadman_catalog/page_${currentProductData.page_reference}.pdf`;
            window.open(pdfFile, '_blank');
        }
    }

    // Show error in modal
    function showError(message) {
        const loading = document.getElementById('catalog-loading');
        loading.innerHTML = `
            <div style="color: #dc3545; text-align: center;">
                <h3>Error</h3>
                <p>${message}</p>
                <button onclick="closeCatalogModal()" class="btn btn-primary">Close</button>
            </div>
        `;
    }

    // Close modal on escape key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeCatalogModal();
        }
    });

    // Close modal on overlay click
    document.addEventListener('click', function(event) {
        if (event.target.id === 'catalog-detail-modal') {
            closeCatalogModal();
        }
    });
    </script>
