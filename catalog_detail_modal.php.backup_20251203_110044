    <!-- Catalog Modal JavaScript -->
    <script>
    // Global variables for catalog modal
    let currentProductData = null;
    let currentImageIndex = 0;
    let productImages = [];

    // Open catalog modal with product data
    function openCatalogModal(productId, searchTerm = '') {
        console.log('Opening catalog modal for product:', productId);
        
        const modal = document.getElementById('catalog-detail-modal');
        const loading = document.getElementById('catalog-loading');
        const content = document.getElementById('catalog-content');
        
        if (!modal) {
            console.error('Catalog modal not found');
            return;
        }
        
        // Show modal and loading state
        modal.style.display = 'flex';
        loading.style.display = 'block';
        content.style.display = 'none';
        
        // Prevent body scroll
        document.body.style.overflow = 'hidden';
        
        // Fetch product data
        fetchProductData(productId, searchTerm);
    }

    // Close catalog modal
    function closeCatalogModal() {
        const modal = document.getElementById('catalog-detail-modal');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }
    }

    // Fetch product data from server
    function fetchProductData(productId, searchTerm) {
        fetch('get_product_modal_data.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `product_id=${encodeURIComponent(productId)}&search_term=${encodeURIComponent(searchTerm)}`
        })
        .then(response => response.json())
        .then(data => {
            console.log('Product data received:', data);
            if (data.success) {
                displayProductData(data.product);
            } else {
                showError(data.error || 'Failed to load product data');
            }
        })
        .catch(error => {
            console.error('Error fetching product data:', error);
            showError('Network error loading product data');
        });
    }

    // Display product data in modal
    function displayProductData(product) {
        currentProductData = product;
        
        const loading = document.getElementById('catalog-loading');
        const content = document.getElementById('catalog-content');
        
        // Update modal title
        document.getElementById('catalog-modal-title').textContent = product.product_name || product.product_id;
        document.getElementById('catalog-modal-subtitle').textContent = product.category ? `${product.category.replace('_', ' ')} Collection` : '';
        
        // Update basic product info
        document.getElementById('product-name').textContent = product.product_name || product.product_id;
        document.getElementById('product-id').textContent = product.product_id;
        document.getElementById('product-category').textContent = product.category ? product.category.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) : '';
        
        // Update pattern info (for Celtic)
        if (product.pattern) {
            document.getElementById('pattern-row').style.display = 'flex';
            document.getElementById('product-pattern').textContent = product.pattern;
        }
        
        // Update width info
        if (product.width_mm) {
            document.getElementById('width-row').style.display = 'flex';
            document.getElementById('product-width').textContent = product.width_mm + 'mm';
        }
        
        // Update style info
        if (product.style) {
            document.getElementById('style-row').style.display = 'flex';
            document.getElementById('product-style').textContent = product.style;
        }
        
        // Setup images
        if (product.images && product.images.length > 0) {
            setupProductImages(product.images);
        } else {
            // Hide image section or show placeholder
            document.querySelector('.product-images').style.display = 'none';
        }
        
        // Setup configurator (for Celtic products)
        if (product.category === 'celtic_bands') {
            setupConfigurator(product);
        } else {
            document.getElementById('configurator-section').style.display = 'none';
        }
        
        // Setup specifications
        setupSpecifications(product);
        
        // Show content, hide loading
        loading.style.display = 'none';
        content.style.display = 'grid';
    }

    // Setup product images
    function setupProductImages(images) {
        productImages = images;
        currentImageIndex = 0;
        
        const mainImage = document.getElementById('catalog-main-image');
        const thumbnailsContainer = document.getElementById('image-thumbnails');
        const navigation = document.getElementById('image-navigation');
        
        // Set main image
        mainImage.src = images[0].url;
        mainImage.alt = images[0].alt || 'Product Image';
        
        // Setup thumbnails if multiple images
        if (images.length > 1) {
            navigation.style.display = 'flex';
            
            thumbnailsContainer.innerHTML = '';
            images.forEach((image, index) => {
                const thumb = document.createElement('img');
                thumb.src = image.thumbnail || image.url;
                thumb.alt = image.alt || 'Product Image';
                thumb.className = 'thumbnail-image' + (index === 0 ? ' active' : '');
                thumb.onclick = () => selectImage(index);
                thumbnailsContainer.appendChild(thumb);
            });
        } else {
            navigation.style.display = 'none';
        }
    }

    // Select image by index
    function selectImage(index) {
        if (index >= 0 && index < productImages.length) {
            currentImageIndex = index;
            document.getElementById('catalog-main-image').src = productImages[index].url;
            
            // Update thumbnail active state
            const thumbnails = document.querySelectorAll('.thumbnail-image');
            thumbnails.forEach((thumb, i) => {
                thumb.classList.toggle('active', i === index);
            });
        }
    }

    // Navigate to previous image
    function previousImage() {
        const newIndex = currentImageIndex > 0 ? currentImageIndex - 1 : productImages.length - 1;
        selectImage(newIndex);
    }

    // Navigate to next image
    function nextImage() {
        const newIndex = currentImageIndex < productImages.length - 1 ? currentImageIndex + 1 : 0;
        selectImage(newIndex);
    }

    // Setup configurator (Celtic products)
    function setupConfigurator(product) {
        const configuratorSection = document.getElementById('configurator-section');
        
        if (product.configurator_options) {
            // Show configurator section
            configuratorSection.style.display = 'block';
            
            // Clear existing hardcoded options and build dynamic ones
            const optionsContainer = document.querySelector('.configurator-options');
            optionsContainer.innerHTML = ''; // Clear hardcoded content
            
            // Store product info for width/ID mapping
            window.currentProduct = product;
            window.celticWidthMapping = {}; // Will store width->productID mapping
            
            // Process each configurator option from JSON
            Object.keys(product.configurator_options).forEach(optionKey => {
                const option = product.configurator_options[optionKey];
                if (!option.options || option.options.length === 0) return;
                
                // Create option group
                const optionGroup = document.createElement('div');
                optionGroup.className = 'option-group';
                optionGroup.id = `${optionKey}-group`;
                
                // Create label
                const label = document.createElement('label');
                label.setAttribute('for', optionKey);
                label.textContent = option.label || optionKey;
                optionGroup.appendChild(label);
                
                // Create select
                const select = document.createElement('select');
                select.id = optionKey;
                select.setAttribute('data-option-key', optionKey);
                select.onchange = function() { 
                    updatePrice(); 
                    if (optionKey === 'size' || optionKey === 'width') updateProductId();
                };
                
                // Handle special cases for width and size
                if (optionKey === 'width') {
                    // For Celtic width, show product IDs instead of just "Wide"
                    setupCelticWidthOptions(select, option, product);
                } else if (optionKey === 'size') {
                    // For size, we'll handle L/M suffix logic
                    setupSizeOptions(select, option);
                } else {
                    // Standard options
                    option.options.forEach(optValue => {
                        const optElement = document.createElement('option');
                        optElement.value = optValue.id;
                        optElement.setAttribute('data-price', optValue.price_modifier || 0);
                        optElement.textContent = `${optValue.name} (+$${optValue.price_modifier || 0})`;
                        
                        // Set default selection
                        if (optValue.id === option.default || (!option.default && optValue === option.options[0])) {
                            optElement.selected = true;
                        }
                        
                        select.appendChild(optElement);
                    });
                }
                
                optionGroup.appendChild(select);
                optionsContainer.appendChild(optionGroup);
                
                // Handle visibility conditions
                if (option.visible_when) {
                    optionGroup.style.display = 'none'; // Initially hidden
                }
            });
            
            // Add inner engraving option
            addEngravingOption(optionsContainer);
            
            // Set up metal selection visibility for Celtic products  
            const karatSelect = document.getElementById('karat_level');
            if (karatSelect) {
                karatSelect.addEventListener('change', function() {
                    const isGold = ['10k', '14k', '18k'].includes(this.value);
                    const patternGroup = document.getElementById('pattern_metal-group');
                    const bandGroup = document.getElementById('band_metal-group');
                    if (patternGroup) patternGroup.style.display = isGold ? 'flex' : 'none';
                    if (bandGroup) bandGroup.style.display = isGold ? 'flex' : 'none';
                });
                // Trigger initial state
                karatSelect.dispatchEvent(new Event('change'));
            }
            
            // Initialize price and product ID
            updatePrice();
            updateProductId();
        } else {
            configuratorSection.style.display = 'none';
        }
    }

    // Setup Celtic width options with product ID mapping
    function setupCelticWidthOptions(select, option, product) {
        // Celtic width mapping based on current product's pattern
        const celticMappings = {
            // Pattern 1: Celtic Link  
            '5296': {'7.5mm': '5296', '6.5mm': '5430', '5.5mm': '5600'},
            '5430': {'7.5mm': '5296', '6.5mm': '5430', '5.5mm': '5600'},
            '5600': {'7.5mm': '5296', '6.5mm': '5430', '5.5mm': '5600'},
            
            // Pattern 2: Roman Key
            '5298': {'7.5mm': '5298', '6.5mm': '5432', '5.5mm': '5602'},
