    "options": {
      "karat_level": {
        "label": "Metal / Purity",
        "required": true,
        "type": "single_select",
        "default": "950_silver",
        "help_text": "Higher karat = more pure metal, softer & more expensive",
        "options": [
          {
            "id": "950_silver",
            "name": ".950 Silver",
            "description": "95% pure silver",
            "price_modifier": -300
          },
          {
            "id": "10k",
            "name": "10K Gold",
            "description": "41.7% pure gold",
            "price_modifier": 0
          },
          {
            "id": "14k",
            "name": "14K Gold",
            "description": "58.5% pure gold",
            "price_modifier": 225
          },
          {
            "id": "18k",
            "name": "18K Gold",
            "description": "75% pure gold",
            "price_modifier": 650
          }
        ]
      },
      "metal_color": {
        "label": "Metal Color",
        "required": true,
        "type": "single_select",
        "default": "yellow",
        "help_text": "Metal color for gold bands",
        "visible_when": {
          "karat_level": [
            "10k",
            "14k",
            "18k"
          ]
        },
        "options": [
          {
            "id": "yellow",
            "name": "Yellow Gold",
            "description": "Classic gold color",
            "price_modifier": 0
          },
          {
            "id": "white",
            "name": "White Gold",
            "description": "Bright platinum-look",
            "price_modifier": 25
          },
          {
            "id": "rose",
            "name": "Rose Gold",
            "description": "Warm pink-gold",
            "price_modifier": 15
          }
        ]
      },
      "gender": {
        "label": "Gender / Sizing",
        "required": true,
        "type": "single_select",
        "default": "M",
        "help_text": "Select Men's or Ladies' sizing",
        "options": [
          {
            "id": "M",
            "name": "Men's",
            "description": "Sizes 8.5 to 12",
