# Environment Configuration Files
# Never commit actual credentials to version control
/config/.env.development
/config/.env.production
/config/.env.staging
/config/.env.local

# But keep the example/template files
!/config/.env.example
!/config/.env.production.template

# Other sensitive files
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json

# Logs
/logs/*
*.log

# Cache files
/cache/*
/tmp/*

# Backup files
*.backup
*.bak
*~

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Dependencies (if using composer later)
/vendor/
composer.lock

# Session files
/sessions/*

# Upload directories
/uploads/temp/*

# Database dumps
*.sql
*.dump

# Catalog files
Cadman_catalog/page_02d.pdf
Cadman_Complete_Catalog_*.zip

# Large binary/media assets (server-only)
PNG/
stl/
images/
*.sql.gz
*.pdf

# Database backup directories
db_backups/
database_backups/
backups/

# PDF/image backup folders generated by scripts
pdf_backups_*/
problematic_pdf_backups_*/

# Root .env
/.env

# Login rate limiting
admin/login_attempts.json
