    // Render page function with performance optimizations
    function renderPage(num) {
        pageRendering = true;
        
        pdfDoc.getPage(num).then(function(page) {
            // Performance optimization: Use devicePixelRatio for crisp rendering
            const devicePixelRatio = window.devicePixelRatio || 1;
            
            // Optimize scale based on device and screen size
            let optimizedScale = scale;
            if (isMobile()) {
                optimizedScale = Math.min(scale, 2.0); // Cap mobile scale for performance
            }
            
            const viewport = page.getViewport({scale: optimizedScale});
            
            // Set actual canvas size for crisp rendering
            canvas.height = viewport.height * devicePixelRatio;
            canvas.width = viewport.width * devicePixelRatio;
            
            // Scale the drawing context for high DPI displays
            ctx.scale(devicePixelRatio, devicePixelRatio);
            
            // Set CSS size to maintain proper display size
            canvas.style.height = viewport.height + 'px';
            canvas.style.width = viewport.width + 'px';
            
            const renderContext = {
                canvasContext: ctx,
                viewport: viewport,
                // Performance improvement: Use 'print' intent for better quality
                intent: 'display'
            };
            
            // Performance: Cancel any existing render task
            if (window.currentRenderTask) {
                window.currentRenderTask.cancel();
            }
            
            const renderTask = page.render(renderContext);
            window.currentRenderTask = renderTask;
            
            renderTask.promise.then(function() {
                pageRendering = false;
                window.currentRenderTask = null;
                
                if (pageNumPending !== null) {
                    renderPage(pageNumPending);
                    pageNumPending = null;
                }
            }).catch(function(error) {
                pageRendering = false;
                window.currentRenderTask = null;
                
                // Handle cancellation gracefully
                if (error.name !== 'RenderingCancelledException') {
                    console.error('Render error:', error);
                }
            });
        });
        
        updatePageInfo();
        updateZoomInfo();
        updateNavigationState();
    }
    
    // Queue render page
    function queueRenderPage(num) {
        if (pageRendering) {
            pageNumPending = num;
        } else {
            renderPage(num);
        }
    }
    
    // Update page info
    function updatePageInfo() {
        if (pdfDoc && pdfDoc.numPages) {
            // Extract catalog section from filename (e.g., "Cadman_catalog_1e.pdf" -> "1e")
            let sectionDisplay = "Page";
            if (currentPdfFile) {
                // Try multiple patterns to extract section
                let match = currentPdfFile.match(/Cadman_catalog_([^.]+)\.pdf$/i) || 
                           currentPdfFile.match(/catalog_([^.]+)\.pdf$/i) || 
                           currentPdfFile.match(/([^/_]+)\.pdf$/i);
                if (match && match[1]) {
                    sectionDisplay = match[1].toUpperCase(); // Extract and uppercase the section
                }
            }
            
            if (pdfDoc.numPages > 1) {
                pageInfo.textContent = `${sectionDisplay} - Page ${pageNum} of ${pdfDoc.numPages}`;
            } else {
                pageInfo.textContent = `Section ${sectionDisplay}`;
            }
        } else {
            pageInfo.textContent = "Loading...";
        }
    }
    
    // Update zoom info display
    function updateZoomInfo() {
        if (isMobile()) {
            // Mobile: show actual rendering scale
            const zoomPercent = Math.round(scale * 100);
            zoomInfo.textContent = `${zoomPercent}%`;
        } else {
            // Desktop: show combined scale (base scale * display scale)
            const zoomPercent = Math.round(scale * displayScale * 100);
            zoomInfo.textContent = `${zoomPercent}%`;
        }
    }
    
    // Update navigation buttons state - handles catalog navigation
    function updateNavigationState() {
        if (!pdfDoc || !catalogFiles || !Array.isArray(catalogFiles)) {
            console.log('updateNavigationState: No PDF or catalog data loaded, disabling buttons');
            prevPageBtn.disabled = true;
            nextPageBtn.disabled = true;
            return;
        }
        
        // Find current catalog file index
        const currentFileIndex = catalogFiles.findIndex(file => file === currentPdfFile);
        console.log('Current file:', currentPdfFile, 'Index:', currentFileIndex, 'Total files:', catalogFiles.length);
        
        // Enable/disable based on catalog position, not individual PDF pages
        const prevShouldDisable = currentFileIndex <= 0;
        const nextShouldDisable = currentFileIndex >= catalogFiles.length - 1;
        
        prevPageBtn.disabled = prevShouldDisable;
        nextPageBtn.disabled = nextShouldDisable;
        
        // Debug: log button states
        console.log(`updateNavigationState: Catalog ${currentFileIndex + 1} of ${catalogFiles.length}`, {
            currentFile: currentPdfFile,
            prevDisabled: prevShouldDisable,
            nextDisabled: nextShouldDisable,
            prevButton: prevPageBtn.disabled,
            nextButton: nextPageBtn.disabled
        });
    }
    
    // Enhanced intelligent search function
    function searchCatalog(query) {
        if (!query.trim()) return;
        
        const searchTerm = query.toLowerCase().trim();
        
        // Use PHP intelligent search via AJAX
        fetch(window.location.href, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'action=search&term=' + encodeURIComponent(searchTerm)
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.type === 'direct_page') {
                // Load the first file from direct page results
                loadPDF(data.files[0]);
                
                if (data.files.length > 1) {
                    setTimeout(() => {
                        let message = `Found ${data.files.length} files for ${data.description}:\n`;
                        data.files.forEach((file, index) => {
                            message += `${index + 1}. ${file}\n`;
                        });
                        message += `\nLoaded: ${data.files[0]}`;
                        message += `\nUse dropdown menu to access other files.`;
                        
                        alert(message);
                    }, 500);
                } else {
                    // Single file found - show confirmation
                    setTimeout(() => {
                        alert(`✅ Found: ${data.description}\nLoaded: ${data.files[0]}`);
                    }, 300);
                }
            } else if (data.length > 0) {
                // Show category results
                const firstResult = data[0];
                const categoryData = firstResult.data;
                
                // Load the main index for this category
                if (categoryData.indexes && categoryData.indexes.length > 0) {
                    loadPDF(categoryData.indexes[0]);
                    
                    // Show search results summary
                    setTimeout(() => {
                        let message = `Found "${firstResult.category}" category (${firstResult.relevance.toFixed(0)}% match)\n`;
                        message += `${categoryData.description}\n\n`;
                        message += `Available content:\n`;
                        message += `• ${categoryData.indexes.length} index pages\n`;
                        message += `• ${categoryData.content_pages.length} content pages\n\n`;
                        
                        if (data.length > 1) {
                            message += `Other matches: ${data.slice(1, 3).map(r => r.category).join(', ')}\n`;
                        }
                        
                        message += `\nShowing main index. Use dropdown for specific pages.`;
                        
                        if (confirm(message + "\n\nView content pages instead?")) {
                            if (categoryData.content_pages.length > 0) {
                                loadPDF(categoryData.content_pages[0]);
                            }
                        }
                    }, 500);
                }
            } else {
                // Fallback to original search
                fallbackSearch(searchTerm);
            }
        })
        .catch(error => {
            console.error('Search error:', error);
            fallbackSearch(searchTerm);
        });
    }
    
    // Fallback search function
    function fallbackSearch(searchTerm) {
        const dropdown = document.getElementById('categorySelect');
        
        // Enhanced search through dropdown options
        const searchResults = [];
        const cleanSearchTerm = searchTerm.replace(/[^a-z0-9]/gi, '').toLowerCase();
        
        for (let option of dropdown.options) {
            if (option.value !== '') {
                const optionText = option.text.toLowerCase();
                const optionValue = option.value.toLowerCase();
                const cleanOptionText = option.text.replace(/[^a-z0-9]/gi, '').toLowerCase();
                const cleanOptionValue = option.value.replace(/[^a-z0-9]/gi, '').toLowerCase();
                
                let score = 0;
                
                // Exact matches get highest score
                if (optionText.includes(searchTerm) || optionValue.includes(searchTerm)) {
                    score = 100;
                }
                // Clean matches (no special chars) get high score
                else if (cleanOptionText.includes(cleanSearchTerm) || cleanOptionValue.includes(cleanSearchTerm)) {
                    score = 90;
                }
                // Partial matches
                else if (optionText.includes(searchTerm.substring(0, Math.max(3, searchTerm.length - 2)))) {
                    score = 70;
                }
                
                if (score > 0) {
                    searchResults.push({
                        text: option.text,
                        value: option.value,
                        score: score
                    });
                }
            }
        }
        
        // Sort by score
        searchResults.sort((a, b) => b.score - a.score);
        
        if (searchResults.length > 0) {
            dropdown.value = searchResults[0].value;
            loadPDF(searchResults[0].value);
            
            if (searchResults.length > 1) {
                setTimeout(() => {
                    let message = `Found ${searchResults.length} results for "${searchTerm}":\n`;
                    searchResults.slice(0, 5).forEach((result, index) => {
                        message += `${index + 1}. ${result.text} (${result.score}% match)\n`;
                    });
                    message += `\nShowing best match: ${searchResults[0].text}`;
                    
                    if (confirm(message + "\n\nCheck dropdown for more options?")) {
                        dropdown.focus();
                    }
                }, 500);
            } else {
                setTimeout(() => {
                    alert(`✅ Found: ${searchResults[0].text}\n(${searchResults[0].score}% match)`);
                }, 300);
            }
        } else {
            alert(`No results found for "${searchTerm}". Try searching for:\n• Page references: "21B", "3A", "page 06"\n• Categories: "wedding", "engagement", "mens", "ladies"\n• Product codes: "5666M", "1000L"\n• Keywords: "cross", "locket", "pendant", "bracelet"`);
        }
    }
    
    // Test if file exists before loading
    function testFileAndLoad(filename, displayName) {
        fetch(`./Cadman_catalog/${filename}`, { method: 'HEAD' })
            .then(response => {
                if (response.ok) {
                    loadPDF(filename);
                } else {
                    alert(`${displayName || filename} not found. Use the dropdown menu to see available pages.`);
                }
            })
            .catch(error => {
                alert(`${displayName || filename} not found. Use the dropdown menu to see available pages.`);
            });
    }
    
    // Fullscreen toggle
    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            pdfContainer.requestFullscreen().catch(err => {
                console.error('Error attempting to enable fullscreen:', err);
            });
        } else {
            document.exitFullscreen();
        }
    }
    
    // Handle window resize
    window.addEventListener('resize', function() {
        if (pdfDoc && canvas) {
            queueRenderPage(pageNum);
        }
    });
    
    // Handle fullscreen changes
    document.addEventListener('fullscreenchange', function() {
        if (document.fullscreenElement) {
            fullscreenBtn.textContent = '⛶ Exit Fullscreen';
        } else {
            fullscreenBtn.textContent = '⛶ Fullscreen';
        }
        
        // Re-render to adjust to new size
        if (pdfDoc && canvas) {
            setTimeout(() => queueRenderPage(pageNum), 100);
        }
    });
    
    // Future zip download functionality placeholder
    function showZipComingSoon() {
        alert('📦 Complete Catalog Download\n\nThis feature is coming soon! You\'ll be able to download the entire catalog as a convenient ZIP file.\n\nFor now, you can download individual pages using the "Download" button when viewing a catalog page.');
    }
    
    // Initialize catalog files when page loads
    document.addEventListener('DOMContentLoaded', function() {
        initializeCatalogFiles();
    });
    </script>
