            canvasWrapper.className = 'pdf-canvas-wrapper';
            canvasWrapper.style.display = 'inline-block';
            canvasWrapper.style.margin = '20px auto';
            canvasWrapper.style.textAlign = 'center';
            canvasWrapper.appendChild(canvas);
            
            // Force enable ALL touch gestures and zoom on the canvas
            canvas.style.touchAction = 'auto';
            canvas.style.msTouchAction = 'auto';
            canvas.style.webkitTouchCallout = 'default';
            canvas.style.webkitUserSelect = 'auto';
            canvas.style.userSelect = 'auto';
            canvas.style.display = 'block';
            canvas.style.margin = '0';
            canvas.style.transformOrigin = '0 0';
            canvas.style.willChange = 'transform';
            
            // Add touch event listeners to ensure gestures work
            canvas.addEventListener('touchstart', function(e) {
                // Don't prevent default - allow native gestures
            }, { passive: true });
            
            canvas.addEventListener('touchmove', function(e) {
                // Don't prevent default - allow native zoom/pan
            }, { passive: true });
            
            ctx = canvas.getContext('2d');
            
            pdfContainer.innerHTML = '';
