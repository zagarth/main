{
    "name": "cadman-mfg/homesite",
    "description": "Cadman Manufacturing website with e-commerce functionality",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "authorizenet/authorizenet": "^2.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "CadmanMfg\\": "src/",
            "CadmanMfg\\Cart\\": "cart/classes/",
            "CadmanMfg\\Payment\\": "cart/payment/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CadmanMfg\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "echo 'Autoloader updated successfully'"
        ]
    }
}